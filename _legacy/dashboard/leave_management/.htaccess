# Legacy module retired - replaced by dashboard/index.php. Safe to delete this folder.
<IfModule mod_alias.c>
    RedirectMatch 302 ^(.*)/dashboard/[a-z_]+(/.*)?$ $1/dashboard/index.php
</IfModule>
<IfModule !mod_alias.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</IfModule>
